{
  "name": "orc-claude",
  "version": "1.0.0",
  "description": "Quét văn bản, bảng và sơ đồ từ ảnh/PDF/DOCX ngay trong trình duyệt - không dùng API AI",
  "type": "module",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/copy-assets.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron electron/main.cjs",
    "electron:dev": "vite build && electron electron/main.cjs",
    "package:win": "vite build && electron-builder --win --x64",
    "package:portable": "vite build && electron-builder --win portable --x64",
    "package:dir": "vite build && electron-builder --dir",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e.mjs && node tests/e2e-claude.mjs"
  },
  "author": "Silentword142",
  "build": {
    "appId": "com.orc.scanner.markitdown",
    "productName": "ORC MarkItDown Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "scripts/**/*",
      "build/icon.png",
      "requirements.txt",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/markitdown",
        "to": "markitdown",
        "filter": [
          "**/*",
          "!.gitkeep"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/vie": "^1.0.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "playwright": "^1.56.1",
    "vite": "^8.3.1"
  }
}
